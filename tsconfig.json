{
    "compilerOptions": {
        "allowJs": true,
        "strict": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "ES2020",
        "rootDir": "./src",
        "esModuleInterop": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationDir": "./@types",
        "emitDeclarationOnly": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules"
    ]
}